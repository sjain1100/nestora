# Application
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000
APP_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Cookie JWT session: generate a unique random secret of at least 32 characters
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

# Cloudinary is optional in development and required for production uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nestora/properties

# Resend HTTPS API works on Render Free; use a verified sender for real recipients
RESEND_API_KEY=
RESEND_FROM=

# Optional SMTP alternative for hosts that allow outbound SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set only when creating the first admin, then remove these values
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

